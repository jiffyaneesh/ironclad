{
  "name": "rule-harness",
  "version": "0.1.0",
  "description": "A rule-enforcement engine for AI coding agents. Rules are compiled into mechanical checks, not prompt text — they don't degrade as context fills up.",
  "type": "module",
  "bin": {
    "rule-harness": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsc && node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "diff": "^9.0.0",
    "js-yaml": "^4.1.0",
    "minimatch": "^9.0.5"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
